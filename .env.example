SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (remove/comment to use SQLite in development)
# DATABASE_URL=postgres://theo:password@localhost:5432/theo_property

# Email (Brevo SMTP). Console backend prints emails to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Theo Property <no-reply@theoproperty.rw>

# The website's public address: used for the buttons and links inside emails
SITE_URL=https://your-domain

# Sign in with Google (staff only). The button appears once both ID and secret are set.
# The redirect URI must also be listed in Google Cloud > Credentials > Authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain/auth/google/callback/

# Google Maps / Places (map falls back to OpenStreetMap when empty)
GOOGLE_MAPS_API_KEY=

# Cloudinary (optional) e.g. cloudinary://key:secret@cloud_name
CLOUDINARY_URL=

SITE_WHATSAPP_NUMBER=250788000000

# MTN MoMo / Airtel Money (future integration)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Sign-in alerts: every sign-in (successful or refused) is emailed here and to the account owner
LOGIN_ALERT_EMAIL=admin@example.com
